# Database connection string for PostgreSQL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hardware_resilient_db?schema=public"

# Server Port
PORT=4000
NODE_ENV="development"

# Agent configuration
AGENT_DEVICE_ID="edge-node-001"
BACKEND_TELEMETRY_URL="http://localhost:4000/api/devices/edge-node-001/telemetry"
AGENT_REPORT_INTERVAL_SECONDS=5
